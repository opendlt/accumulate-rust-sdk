{
  "name": "accumulate-rust-sdk",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // `make ci-check` runs fmt-check, lint, test, coverage-gate and audit. A
  // container that ships rustc but not cargo-audit/llvm-cov fails the very
  // command it exists to guarantee, so install the toolchain the Makefile needs.
  // llvm-tools-preview is required by cargo-llvm-cov, which `make coverage-gate`
  // needs. This directory IS the crate root: Cargo.toml sits here, not in a subdir.
  "postCreateCommand": "rustup component add rustfmt clippy llvm-tools-preview && cargo install cargo-audit cargo-llvm-cov --locked && cargo fetch",

  "containerEnv": {
    "ACCUMULATE_NETWORK": "kermit",
    "CARGO_TERM_COLOR": "never"
  },

  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml"],
      "settings": {
        "rust-analyzer.linkedProjects": ["Cargo.toml"]
      }
    }
  },

  // remoteUser is root deliberately.
  //
  // Verified on Docker Desktop for Windows: bind-mounted workspace files are
  // presented as root:root, `chown` on them fails, and a non-root user cannot
  // call utime on them. Every command these containers are built to run writes
  // into the workspace (`dart pub get` touches pubspec.lock, `pip install -e .`
  // writes egg-info, `npm ci` writes node_modules, `cargo build` writes target/,
  // `dotnet restore` writes obj/), so a non-root remoteUser made `dart test`
  // fail with "Operation not permitted" before running a single test.
  //
  // The isolation boundary here is the CONTAINER, not the in-container user: the
  // only host path mounted is the workspace, and no credentials are baked in. On
  // a Linux or macOS host, prefer the image's non-root user instead — there the
  // bind mount carries real ownership and root would leave root-owned files on
  // the host.
  "remoteUser": "root"
}
